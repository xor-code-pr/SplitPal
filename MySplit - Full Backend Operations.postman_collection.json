				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const json = pm.response.json();",
							"const groupId = json && json.group && json.group.id ? json.group.id : (json && (json.id || json.group_id) ? (json.id || json.group_id) : null);",
