		{
			"name": "Admin (start here)",
			"item": [
				{
					"name": "Login Purnendu (admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const json = pm.response.json();",
									"if (json && json.token) { pm.collectionVariables.set('token_admin', json.token); }",
									"if (json && json.refresh_token) { pm.collectionVariables.set('refresh_token_admin', json.refresh_token); }"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
						},
						"url": "{{base_url}}/users/login"
					},
					"response": []
				},
				{
					"name": "Admin: List users",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const users = pm.response.json();",
									"if (Array.isArray(users)) {",
									"  const a = users.find(u => u.email === pm.collectionVariables.get('user_email'));",
									"  const b = users.find(u => u.email === pm.collectionVariables.get('user_b_email'));",
									"  if (a && a.name) pm.collectionVariables.set('user_a_name', a.name);",
									"  if (b && b.name) pm.collectionVariables.set('user_b_name', b.name);",
								"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token_admin}}"
							}
						],
						"url": "{{base_url}}/management/users"
					},
					"response": []
				},
				{
					"name": "Admin: List groups",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token_admin}}"
							}
						],
						"url": "{{base_url}}/management/groups"
					},
					"response": []
				},
				{
					"name": "Admin: Delete user",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token_admin}}"
							}
						],
						"url": "{{base_url}}/management/users/{{user_id}}"
					},
					"response": []
				},
				{
					"name": "Admin: Delete group",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token_admin}}"
							}
						],
						"url": "{{base_url}}/management/groups/{{group_id}}"
					},
					"response": []
				}
			],
			"description": "Admin endpoints grouped first for convenience. Use an admin user's token (Purnendu) to call these."
